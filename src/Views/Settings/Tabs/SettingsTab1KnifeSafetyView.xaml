<UserControl x:Class="CursorTestApp.Views.Settings.Tabs.SettingsTab1KnifeSafetyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- MAX：藍底白字；MIN：紅底橘字（TODO_Phase7_Layout Tab1） -->
        <Style x:Key="KnifeMaxTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="KnifeMinTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="#FFEDD5" />
            <Setter Property="Background" Value="#B91C1C" />
            <Setter Property="BorderBrush" Value="#991B1B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="KnifeFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalContentAlignment="Center"
                  Padding="12,8">
        <Border MaxWidth="1080"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="8,12"
                Background="#FFFFFF">
            <!-- Layout 對齊 TODO_Phase7_Layout §Tab1 視覺區塊：EJKF 在底圖上方；A 在底圖下方；H/I/B 在底圖右方（列內 左 MAX 右 MIN） -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 上方橫列：E、J、K、F（每欄 上 MAX / 下 MIN），在底圖上方 -->
                <UniformGrid Grid.Row="0"
                             Grid.Column="0"
                             Margin="0,0,0,10"
                             Columns="4"
                             HorizontalAlignment="Center">
                    <StackPanel Margin="6,0">
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxE.Value}" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotEMax, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinE.Value}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotEMin, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxJ.Value}" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotJMax, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinJ.Value}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotJMin, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxK.Value}" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotKMax, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinK.Value}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotKMin, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Margin="6,0">
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxF.Value}" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotFMax, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinF.Value}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotFMin, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                    </StackPanel>
                </UniformGrid>

                <!-- 底圖（左欄） -->
                <Image Grid.Row="1"
                       Grid.Column="0"
                       MaxHeight="300"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       SnapsToDevicePixels="True"
                       Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/Box_Measurement_3-removebg-preview.png" />

                <!-- 右側直列：H、I、B（上→下；每列 左 MAX / 右 MIN），在底圖右方、與底圖列對齊 -->
                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="108" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxH.Value}" />
                            <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotHMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="108">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinH.Value}" />
                            <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotHMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel Width="108" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxI.Value}" />
                            <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotIMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="108">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinI.Value}" />
                            <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotIMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="108" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxB.Value}" />
                            <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotBMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="108">
                            <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinB.Value}" />
                            <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotBMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部：MAX A / MIN A，在底圖下方（僅左欄寬度） -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,14,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MaxA.Value}" />
                        <TextBox Style="{StaticResource KnifeMaxTextBox}" Text="{Binding KnifeSlotAMax, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource KnifeFieldLabel}" Text="{Binding MinA.Value}" />
                        <TextBox Style="{StaticResource KnifeMinTextBox}" Text="{Binding KnifeSlotAMin, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
