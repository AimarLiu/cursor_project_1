<ui:FluentWindow x:Class="CursorTestApp.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shared="clr-namespace:CursorTestApp.Views.Shared"
                 Title="Cursor Test App"
                 Icon="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-app-96.png"
                 WindowState="Maximized"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="17*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <ContentControl x:Name="ContentHost"
                        Grid.Row="0" Grid.Column="0"
                        Grid.RowSpan="2" Grid.ColumnSpan="2" />

        <Border x:Name="LogPanelBorder" Grid.Row="1" Grid.Column="1"
                Background="#E01a1a2e"
                Margin="8"
                CornerRadius="4"
                Visibility="Visible">
            <shared:LogPanel x:Name="LogPanel" />
        </Border>
    </Grid>
</ui:FluentWindow>
