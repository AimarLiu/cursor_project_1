<UserControl x:Class="CursorTestApp.Views.Layout2.ProductionInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding ProductionInfoPanelTitle.Value}" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProductionOrderLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FirstScheduleItem.OrderNo, FallbackValue=--}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ProductionVersionLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirstScheduleItem.VersionNo, FallbackValue=--}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding SpeedLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Speed, FallbackValue=0}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding CurrentQuantityLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentQuantity, FallbackValue=0}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding OrderQuantityLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirstScheduleItem.OrderQuantity, FallbackValue=--}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding EstimatedCompleteLabel.Value, StringFormat={}{0}:}" FontSize="15" Foreground="#CCFFFFFF" Margin="0,4" VerticalAlignment="Center" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EstimatedTimeDisplay}" FontSize="15" Foreground="White" Margin="0,4" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
