    <UserControl x:Class="CursorTestApp.Views.Settings.Tabs.SettingsTab3OtherPlcParametersView"
                 x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             Foreground="#1E293B">
    <UserControl.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Tab3ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Tab3DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <Style x:Key="Tab3FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Tab3TextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style x:Key="Tab3ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="Tab3ComboBoxItemTemplate">
            <TextBlock Text="{Binding}" Foreground="#0F172A" Padding="2,0" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="Tab3ComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Tab3ComboBoxItemStyle}" />
            <Setter Property="ItemTemplate" Value="{StaticResource Tab3ComboBoxItemTemplate}" />
        </Style>
        <Style x:Key="Tab3GroupBox" TargetType="GroupBox">
            <Setter Property="Padding" Value="10,8,10,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8" MaxWidth="1680" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="160" />
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="340" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- 左：部門 -->
        <Border Grid.Column="0"
                Margin="0,0,10,0"
                Padding="8"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Background="#F8FAFC">
            <ListBox ItemsSource="{Binding DepartmentItems}"
                     SelectedValue="{Binding SelectedDepartmentCode, Mode=TwoWay}"
                     SelectedValuePath="Code"
                     BorderThickness="0"
                     Background="#F8FAFC"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label.Value}"
                                   TextWrapping="Wrap"
                                   Foreground="#0F172A"
                                   Padding="2,4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 中：DataGrid -->
        <DataGrid Grid.Column="1"
                  Margin="0,0,10,0"
                  ItemsSource="{Binding GridRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  ColumnHeaderStyle="{StaticResource Tab3DataGridColumnHeaderStyle}"
                  GridLinesVisibility="Horizontal"
                  RowHeight="32"
                  Foreground="#0F172A"
                  Background="#FFFFFF"
                  BorderBrush="#CBD5E1"
                  AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColDepartment"
                                    Width="88"
                                    Header=""
                                    Binding="{Binding DepartmentCode, Mode=OneWay}"
                                    IsReadOnly="True"
                                    Visibility="{Binding DataContext.ShowDepartmentColumnInGrid, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}" />
                <DataGridTextColumn x:Name="ColComponentName"
                                    Width="*"
                                    Header=""
                                    Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn x:Name="ColMax"
                                    Width="100"
                                    Header=""
                                    Binding="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn x:Name="ColMin"
                                    Width="100"
                                    Header=""
                                    Binding="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn x:Name="ColAccurate"
                                    Width="100"
                                    Header=""
                                    Binding="{Binding AccurateText, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 右：通訊 + 使用者 -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Style="{StaticResource Tab3GroupBox}" Header="{Binding GroupOtherCommPorts.Value}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Text="{Binding LabelPrinterPlcPort.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding ComPortOptions}"
                                  SelectedItem="{Binding PrinterPort, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Margin="0,10,0,4" Text="{Binding LabelPanelPort.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding ComPortOptions}"
                                  SelectedItem="{Binding PanelPort, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Style="{StaticResource Tab3GroupBox}" Header="{Binding GroupGluePlc.Value}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Text="{Binding LabelGluePlcPort.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding ComPortOptions}"
                                  SelectedItem="{Binding GluePort, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Margin="0,8,0,4" Text="{Binding LabelBaudRate.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding BaudOptions}"
                                  SelectedItem="{Binding GlueBaudRate, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Margin="0,8,0,4" Text="{Binding LabelByteSize.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding ByteSizeOptions}"
                                  SelectedItem="{Binding GlueByteSize, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Margin="0,8,0,4" Text="{Binding LabelParity.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding ParityOptions}"
                                  SelectedItem="{Binding GlueParity, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Tab3FieldLabel}" Margin="0,8,0,4" Text="{Binding LabelStopBits.Value}" />
                        <ComboBox Style="{StaticResource Tab3ComboBox}"
                                  ItemsSource="{Binding StopBitsOptions}"
                                  SelectedItem="{Binding GlueStopBits, Mode=TwoWay}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Style="{StaticResource Tab3GroupBox}" Header="{Binding GroupUserPassword.Value}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Tab3FieldLabel}"
                                   Text="{Binding LabelUserPassword.Value}" />
                        <TextBox Style="{StaticResource Tab3TextBox}"
                                 Text="{Binding UserPassword, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource Tab3FieldLabel}"
                                   Margin="0,12,0,4"
                                   Text="{Binding LabelAdminPassword.Value}" />
                        <TextBox Style="{StaticResource Tab3TextBox}"
                                 Text="{Binding AdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
