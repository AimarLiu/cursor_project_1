<UserControl x:Class="CursorTestApp.Views.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0" />
                <GradientStop Color="#16213e" Offset="0.5" />
                <GradientStop Color="#0f3460" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 右上角 X 離開按鈕 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="24" Width="40" Height="40"
                Command="{Binding ExitCommand}"
                Background="Transparent" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                FontSize="20" Content="✕"
                ToolTip="{Binding ExitToolTip.Value}" />

        <!-- 裝飾層：左上大圓 -->
        <Ellipse Width="400" Height="400"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-100,-100,0,0"
                 Fill="#15000000" Opacity="0.8">
            <Ellipse.Effect>
                <BlurEffect Radius="60" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- 裝飾層：右下落圓 -->
        <Ellipse Width="250" Height="250"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-80,-80"
                 Fill="#12000000" Opacity="0.6">
            <Ellipse.Effect>
                <BlurEffect Radius="40" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- 中央登入區塊（卡片 + 語系切換） -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="360" HorizontalAlignment="Center"
                Background="#40FFFFFF" CornerRadius="12" Padding="32"
                BorderBrush="#33FFFFFF" BorderThickness="1"
                Focusable="True">
            <Border.InputBindings>
                <KeyBinding Key="Return" Command="{Binding LoginCommand}" />
            </Border.InputBindings>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding LoginTitle.Value}" FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />

                <ui:PasswordBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding PasswordPlaceholder.Value}"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Content="{Binding EnterButton.Value}"
                               Command="{Binding LoginCommand}"
                               Appearance="Primary"
                               Margin="0,0,12,0" />
                    <ui:Button Content="{Binding CancelButton.Value}"
                               Command="{Binding CancelCommand}"
                               Appearance="Secondary" />
                </StackPanel>
                <!-- 登入錯誤提示（密碼錯誤／請輸入密碼） -->
                <TextBlock Text="{Binding LoginErrorMessage}"
                           Foreground="#FFE57373"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="{Binding LoginErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- 語系切換（Login 方框下方） -->
        <ComboBox ItemsSource="{Binding SupportedLanguages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  DisplayMemberPath="DisplayName"
                  Width="200" Margin="0,24,0,0"
                  HorizontalAlignment="Center"
                  FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
