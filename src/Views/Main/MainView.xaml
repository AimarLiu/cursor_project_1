<UserControl x:Class="CursorTestApp.Views.Main.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0" />
                <GradientStop Color="#16213e" Offset="0.5" />
                <GradientStop Color="#0f3460" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 裝飾層：左上大圓 -->
        <Ellipse Width="400" Height="400"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-100,-100,0,0"
                 Fill="#15000000" Opacity="0.8">
            <Ellipse.Effect>
                <BlurEffect Radius="60" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- 裝飾層：右下落圓 -->
        <Ellipse Width="250" Height="250"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-80,-80"
                 Fill="#12000000" Opacity="0.6">
            <Ellipse.Effect>
                <BlurEffect Radius="40" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- 中央區域：主畫面標題（依語系動態切換） -->
        <TextBlock Text="{Binding MainPageTitle.Value}"
                   FontSize="32" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 左下角返回登入頁按鈕 -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24" Width="48" Height="48"
                Command="{Binding NavigateBackCommand}"
                Background="Transparent" Foreground="White"
                BorderThickness="0" Cursor="Hand"
                FontSize="28" Content="⬅"
                ToolTip="{Binding BackToLoginToolTip.Value}" />
    </Grid>
</UserControl>
