<Window x:Class="CursorTestApp.Views.Layout2.ScheduleManageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title.Value}"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#1a1a2e">
    <Window.Resources>
        <!-- 與 Layout2 生產排程相同：DataGrid 列/儲存格樣式（避免 whyDataGridleg：選取視覺、無框線） -->
        <Style x:Key="Layout2DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Layout2DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 5.2 標題列：黃底黑字（與 Layout2 同字體 18、Padding、MinHeight） -->
        <Style x:Key="DialogDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F9A825" />
            <Setter Property="Foreground" Value="#111" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部：版號說明 + 目前版號 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding VersionLabel.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="{Binding FirstScheduleItem.VersionNo, FallbackValue='', TargetNullValue=''}" Foreground="White" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 中央：生產訂單 DataGrid（與 Layout2 上區相同控制項與樣式，避免 whyDataGridleg；標題列黃底黑字） -->
        <DataGrid Grid.Row="1" x:Name="ScheduleDataGrid"
                  ItemsSource="{Binding ScheduleOrders}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" Margin="0,0,0,12"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  FontSize="18"
                  Background="#40000000" Foreground="White"
                  RowBackground="#33FFFFFF" AlternatingRowBackground="#22FFFFFF"
                  BorderThickness="0"
                  ColumnHeaderStyle="{StaticResource DialogDataGridColumnHeaderStyle}"
                  RowStyle="{StaticResource Layout2DataGridRowStyle}"
                  CellStyle="{StaticResource Layout2DataGridCellStyle}"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1976D2" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
            </DataGrid.Resources>
            <DataGrid.Columns>
                <!-- 標題於 Loaded 時由 code-behind 自 ViewModel 填入 -->
                <DataGridTextColumn x:Name="DialogColOrderNo" Binding="{Binding OrderNo}" Width="135" />
                <DataGridTextColumn x:Name="DialogColVersionNo" Binding="{Binding VersionNo}" Width="135" />
                <DataGridTextColumn x:Name="DialogColOrderQuantity" Binding="{Binding OrderQuantity}" Width="105" />
                <DataGridTextColumn x:Name="DialogColBoxType" Binding="{Binding BoxType}" Width="75" />
                <DataGridTextColumn x:Name="DialogColCategory" Binding="{Binding Category}" Width="75" />
                <DataGridTextColumn x:Name="DialogColCustomerName" Binding="{Binding CustomerName}" Width="120" />
                <DataGridTextColumn x:Name="DialogColRemarks" Binding="{Binding Remarks}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：F4 分印、F2 前置排單、F3 把全排量、F1 離開 -->
        <Border Grid.Row="2" Background="#F9A825" Padding="12,10" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Command="{Binding F4PrintDialogCommand}" MinWidth="100" Height="40" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#111" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-bear-footprint-80.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding F4Print.Value}" VerticalAlignment="Center" Foreground="#111" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding F2PreScheduleDialogCommand}" MinWidth="120" Height="40" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#111" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-frying-pan-96.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding F2PreSchedule.Value}" VerticalAlignment="Center" Foreground="#111" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding F3FullScheduleDialogCommand}" MinWidth="120" Height="40" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#111" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-process-80.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding F3FullSchedule.Value}" VerticalAlignment="Center" Foreground="#111" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding F1ExitDialogCommand}" MinWidth="90" Height="40"
                        Background="Transparent" Foreground="#111" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-exit-96.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding F1Exit.Value}" VerticalAlignment="Center" Foreground="#111" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
