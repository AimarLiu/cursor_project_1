<UserControl x:Class="CursorTestApp.Views.Layout2.OrderMakingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E0E0E0">
    <UserControl.Resources>
        <Style x:Key="OrderDgCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OrderDgRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1976D2" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 左側：白底；反灰時淺灰 -->
        <Style x:Key="LeftPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftAndBottomEnabled}" Value="False">
                    <Setter Property="Background" Value="#F0F0F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 下側 4.5：白底；反灰時淺灰 -->
        <Style x:Key="BottomPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLeftAndBottomEnabled}" Value="False">
                    <Setter Property="Background" Value="#F0F0F0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Phase 6 輸入／顯示：預設白底黑字，可輸入狀態（焦點）黃底 -->
        <Style x:Key="Phase6TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#B3E5FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FFF9C4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem" x:Key="Phase6ComboBoxItemStyle">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
        </Style>
        <Style x:Key="Phase6ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="BorderBrush" Value="#B3E5FC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource Phase6ComboBoxItemStyle}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#FFF9C4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 4.1 / 4.2 頂部（深灰色配色） -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#333333" Padding="12,8" Margin="0,0,0,10" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <!-- 左側頂部：標題、版號、F6 搜尋 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title.Value}" Foreground="#E0E0E0" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding VersionNoLabel.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding VersionNoSearch, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="28" Padding="4,2"
                             Style="{StaticResource Phase6TextBoxStyle}" VerticalContentAlignment="Center" CaretBrush="Black"
                             KeyDown="VersionNoSearch_KeyDown" />
                    <Button Command="{Binding SearchByVersionNoCommand}" Margin="8,0,0,0" MinWidth="90" Height="36"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-search-property-80.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding F6Search.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Button>
                </StackPanel>
                <!-- 右側頂部：版號查詢、上下箭頭、預覽 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionNoQueryLabel.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding VersionNoQuery, UpdateSourceTrigger=PropertyChanged}" Width="144" Height="26" Padding="4,2"
                             Style="{StaticResource Phase6TextBoxStyle}" VerticalContentAlignment="Center" CaretBrush="Black"
                             KeyDown="VersionNoQuery_KeyDown" />
                    <Button Command="{Binding PrevPageCommand}" MinWidth="44" Height="36" Margin="6,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-collapse-arrow-96.png" Width="24" Height="24" />
                    </Button>
                    <Button Command="{Binding NextPageCommand}" MinWidth="44" Height="36" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,0">
                        <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-expand-arrow-96.png" Width="24" Height="24" />
                    </Button>
                    <Button Command="{Binding PreviewSelectedCommand}" Margin="8,0,0,0" MinWidth="90" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-package-search-96.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding PreviewLabel.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding SubmitVersionPositionCommand}" Margin="8,0,0,0" MinWidth="100" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-insert-96.png" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding SubmitVersionPositionLabel.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4.3 左側輸入區 | 4.4 右側 DataGrid -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LeftPanelBorderStyle}" Padding="12" Margin="0,0,10,0" BorderBrush="#B3E5FC" BorderThickness="1" CornerRadius="4" IsEnabled="{Binding IsLeftAndBottomEnabled}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding OrderNoLabel.Value}" Foreground="Black" Width="100" VerticalAlignment="Center" />
                        <TextBox Text="{Binding OrderNo, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="24" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding OrderQuantityLabel.Value}" Foreground="Black" Width="100" VerticalAlignment="Center" />
                        <TextBox Text="{Binding OrderQuantity, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="24" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CategoryLabel.Value}" Foreground="Black" Width="100" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Category, Mode=TwoWay}" Width="180" Height="26" Background="#FFFFFF" Foreground="Black" Style="{StaticResource Phase6ComboBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding BoxTypeLabel.Value}" Foreground="Black" Width="100" VerticalAlignment="Center" />
                        <RadioButton Content="E" IsChecked="{Binding IsBoxTypeE, Mode=TwoWay}" GroupName="BoxType" Foreground="Black" Margin="0,0,16,0" />
                        <RadioButton Content="S" IsChecked="{Binding IsBoxTypeS, Mode=TwoWay}" GroupName="BoxType" Foreground="Black" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CustomerNameLabel.Value}" Foreground="Black" Width="100" VerticalAlignment="Center" />
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="24" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding RemarksLabel.Value}" Foreground="Black" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Height="96" Padding="4" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource Phase6TextBoxStyle}" />
                </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" Padding="6" BorderBrush="#B3E5FC" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="OrdersGrid" ItemsSource="{Binding OrdersPage}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                          SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                          MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                          FontSize="13" Background="#FFFFFF" Foreground="Black" RowBackground="#FFFFFF" AlternatingRowBackground="#F5F5F5" BorderThickness="0"
                          RowStyle="{StaticResource OrderDgRow}" CellStyle="{StaticResource OrderDgCell}">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1976D2" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColVersionNo" Binding="{Binding VersionNo}" Width="100" />
                        <DataGridTextColumn x:Name="ColCustomerName" Binding="{Binding CustomerName}" Width="80" />
                        <DataGridTextColumn x:Name="ColBoxType" Binding="{Binding BoxType}" Width="50" />
                        <DataGridTextColumn x:Name="ColCategory" Binding="{Binding Category}" Width="50" />
                        <DataGridTextColumn x:Name="ColCreatedAt" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy/MM/dd HH:mm\}}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
        </Border>

        <!-- 4.5 下側（高度 3/8）：比例 5:1:4；預覽區寬度輸入右側中間、長度輸入下側中間；楞別圖填滿無 border 可失真 -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource BottomPanelBorderStyle}" Padding="10" Margin="0,10,0,10" CornerRadius="4" BorderBrush="#B3E5FC" BorderThickness="1" IsEnabled="{Binding IsLeftAndBottomEnabled}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <!-- 箱型圖形預覽區：矩形區域使用棕色 -->
                <Border Grid.Column="0" Background="#C4A574" Margin="0,0,10,0" BorderBrush="#8B7355" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" FontSize="12">
                            <Run Text="L:" /><Run Text="{Binding Length, Mode=OneWay}" />
                            <Run Text=" W:" /><Run Text="{Binding Width, Mode=OneWay}" />
                        </TextBlock>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding WidthLabel.Value}" Foreground="Black" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Padding="4,2" FontSize="12" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" IsEnabled="{Binding IsLeftAndBottomEnabled}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Orientation="Horizontal" Margin="4">
                            <TextBlock Text="{Binding LengthLabel.Value}" Foreground="Black" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Padding="4,2" FontSize="12" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" IsEnabled="{Binding IsLeftAndBottomEnabled}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PhaseLabel.Value}" Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Phase1ColorLabel.Value}" Foreground="Black" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Phase1, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="22" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="0,0,0,6">
                        <TextBlock Text="{Binding Phase2ColorLabel.Value}" Foreground="Black" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Phase2, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="22" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Phase3ColorLabel.Value}" Foreground="Black" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Phase3, UpdateSourceTrigger=PropertyChanged}" Width="60" Height="22" Padding="4,2" VerticalContentAlignment="Center" Style="{StaticResource Phase6TextBoxStyle}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="2" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/type_of_cardboard.png"
                           Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4.6 底部功能提示（深灰色配色；F4 最左、F5、F2、F1 最右） -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#333333" Padding="16,8" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Button Command="{Binding DeleteOrderCommand}" MinWidth="120" Height="48" Margin="0,0,8,0"
                        IsEnabled="{Binding IsF4Enabled}" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-delete-96.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding F4Delete.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                <Button Command="{Binding SaveOrderCommand}" MinWidth="140" Height="48" Margin="0,0,8,0"
                        IsEnabled="{Binding IsF5Enabled}" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-edit-80.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsF5AddOrderMode}" Value="True">
                                            <Setter Property="Source" Value="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-add-96.png" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Grid.Column="1" Text="{Binding F5ButtonText}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                <Button Command="{Binding AddToScheduleAndCloseCommand}" MinWidth="130" Height="48" Margin="0,0,8,0"
                        IsEnabled="{Binding IsF2Enabled}" Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-submit-document-96.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding F2AddToSchedule.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CloseCommand}" MinWidth="120" Height="48"
                        HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#E0E0E0" BorderThickness="0" Cursor="Hand">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="pack://application:,,,/CursorTestApp;component/Resources/Icons/icons8-exit-96.png" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding F1Exit.Value}" Foreground="#E0E0E0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
